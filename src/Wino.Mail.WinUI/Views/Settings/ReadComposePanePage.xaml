<abstract:ReadComposePanePageAbstract
    x:Class="Wino.Views.Settings.ReadComposePanePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:ai="using:Wino.Core.Domain.Models.Ai"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:translations="using:Wino.Core.Domain.Models.Translations"
    mc:Ignorable="d">

    <StackPanel>
        <controls:SettingsExpander
            AutomationProperties.AutomationId="MailTranslationSettingsExpander"
            Description="{x:Bind domain:Translator.MailTranslation_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.MailTranslation_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Translate" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard Header="{x:Bind domain:Translator.MailTranslation_Provider, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="MailTranslationProvider"
                        AutomationProperties.Name="{x:Bind domain:Translator.MailTranslation_Provider, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.MailTranslation.Providers}"
                        SelectedIndex="{x:Bind ViewModel.MailTranslation.ProviderIndex, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="{x:Bind domain:Translator.MailTranslation_TargetLanguage, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="MailTranslationTargetLanguage"
                        AutomationProperties.Name="{x:Bind domain:Translator.MailTranslation_TargetLanguage, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.MailTranslation.Languages}"
                        SelectedItem="{x:Bind ViewModel.MailTranslation.TargetLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="ai:AiTranslateLanguageOption">
                                <TextBlock Text="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard Header="{x:Bind domain:Translator.MailTranslation_SourceLanguage, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="MailTranslationSourceLanguage"
                        AutomationProperties.Name="{x:Bind domain:Translator.MailTranslation_SourceLanguage, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.MailTranslation.SourceLanguages}"
                        SelectedItem="{x:Bind ViewModel.MailTranslation.SourceLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="ai:AiTranslateLanguageOption">
                                <TextBlock Text="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    ContentAlignment="Vertical"
                    Visibility="{x:Bind ViewModel.MailTranslation.IsOpenAi, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBox
                            AutomationProperties.AutomationId="MailTranslationOpenAiEndpoint"
                            Header="{x:Bind domain:Translator.MailTranslation_Endpoint, Mode=OneTime}"
                            Text="{x:Bind ViewModel.MailTranslation.OpenAiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{x:Bind domain:Translator.MailTranslation_EndpointHint, Mode=OneTime}" TextWrapping="Wrap" />
                        <TextBox
                            AutomationProperties.AutomationId="MailTranslationOpenAiModel"
                            Header="{x:Bind domain:Translator.MailTranslation_Model, Mode=OneTime}"
                            Text="{x:Bind ViewModel.MailTranslation.OpenAiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            MinHeight="100"
                            MaxHeight="240"
                            AcceptsReturn="True"
                            AutomationProperties.AutomationId="MailTranslationPrompt"
                            Header="{x:Bind domain:Translator.MailTranslation_Prompt, Mode=OneTime}"
                            Text="{x:Bind ViewModel.MailTranslation.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind domain:Translator.MailTranslation_PromptHint, Mode=OneTime}" TextWrapping="Wrap" />
                        <Button
                            AutomationProperties.AutomationId="MailTranslationResetPrompt"
                            Command="{x:Bind ViewModel.MailTranslation.ResetPromptCommand}"
                            Content="{x:Bind domain:Translator.MailTranslation_ResetPrompt, Mode=OneTime}" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    ContentAlignment="Vertical"
                    Visibility="{x:Bind ViewModel.MailTranslation.IsPlamo, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind domain:Translator.MailTranslation_PlamoHint, Mode=OneTime}" TextWrapping="Wrap" />
                        <TextBox
                            AutomationProperties.AutomationId="MailTranslationPlamoEndpoint"
                            Header="{x:Bind domain:Translator.MailTranslation_Endpoint, Mode=OneTime}"
                            Text="{x:Bind ViewModel.MailTranslation.PlamoEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            AutomationProperties.AutomationId="MailTranslationPlamoModel"
                            Header="{x:Bind domain:Translator.MailTranslation_Model, Mode=OneTime}"
                            Text="{x:Bind ViewModel.MailTranslation.PlamoModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Description="{x:Bind domain:Translator.MailTranslation_SarashinaLanguages, Mode=OneTime}" Visibility="{x:Bind ViewModel.MailTranslation.IsSarashina, Mode=OneWay}" />
                <controls:SettingsCard
                    Description="{x:Bind domain:Translator.MailTranslation_DeepLHint, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.MailTranslation_DeepLFree, Mode=OneTime}"
                    Visibility="{x:Bind ViewModel.MailTranslation.IsDeepL, Mode=OneWay}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="MailTranslationDeepLFree"
                        AutomationProperties.Name="{x:Bind domain:Translator.MailTranslation_DeepLFree, Mode=OneTime}"
                        IsOn="{x:Bind ViewModel.MailTranslation.DeepLFreeApi, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Description="{x:Bind domain:Translator.MailTranslation_KeyHint, Mode=OneTime}" Header="{x:Bind domain:Translator.MailTranslation_ApiKey, Mode=OneTime}">
                    <PasswordBox
                        Width="260"
                        AutomationProperties.AutomationId="MailTranslationApiKey"
                        AutomationProperties.Name="{x:Bind domain:Translator.MailTranslation_ApiKey, Mode=OneTime}"
                        Password="{x:Bind ViewModel.MailTranslation.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
                <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                    <StackPanel Spacing="12">
                        <Button
                            AutomationProperties.AutomationId="MailTranslationSaveSettings"
                            Command="{x:Bind ViewModel.MailTranslation.SaveCommand}"
                            Content="{x:Bind domain:Translator.Buttons_Save, Mode=OneTime}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.MailTranslation.Status, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
        <controls:SettingsExpander
            AutomationProperties.AutomationId="ReadComposePanePageSettingsExpander"
            Description="{x:Bind domain:Translator.SettingsReaderFontFamily_Description}"
            Header="{x:Bind domain:Translator.SettingsReaderFont_Title}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="TextFont" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard AutomationProperties.AutomationId="ReadComposePanePageSettingsCard" Header="{x:Bind domain:Translator.SettingsFontFamily_Title}">
                    <ComboBox
                        AutomationProperties.AutomationId="ReadComposePanePageComboBox"
                        ItemsSource="{x:Bind ViewModel.AvailableFonts}"
                        SelectedItem="{x:Bind ViewModel.CurrentReaderFont, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock FontFamily="{x:Bind}" Text="{x:Bind}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard AutomationProperties.AutomationId="ReadComposePanePageSettingsCard2" Header="{x:Bind domain:Translator.SettingsFontSize_Title}">
                    <NumberBox
                        AutomationProperties.AutomationId="ReadComposePanePageNumberBox"
                        LargeChange="5"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.CurrentReaderFontSize, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard AutomationProperties.AutomationId="ReadComposePanePageSettingsCard3" Header="{x:Bind domain:Translator.SettingsFontPreview_Title}">
                    <TextBlock
                        FontFamily="{x:Bind ViewModel.CurrentReaderFont, Mode=OneWay}"
                        FontSize="{x:Bind ViewModel.CurrentReaderFontSize, Mode=OneWay}"
                        Text="The quick brown fox jumps over the lazy dog"
                        TextWrapping="WrapWholeWords" />
                </controls:SettingsCard>


            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="ReadComposePanePageReaderDarkModeExpander"
            Description="{x:Bind domain:Translator.SettingsReaderDarkMode_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsReaderDarkMode_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="DarkEditor" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="ReadComposePanePageReaderMessageColorsCard"
                    Description="{x:Bind domain:Translator.SettingsReaderMessageColors_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsReaderMessageColors_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="ReadComposePanePageReaderMessageColorsComboBox"
                        ItemsSource="{x:Bind ViewModel.ReaderContentThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedReaderContentThemeIndex, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="ReadComposePanePageReaderDarkModeMethodCard"
                    ContentAlignment="Vertical"
                    Description="{x:Bind domain:Translator.SettingsReaderDarkModeMethod_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsReaderDarkModeMethod_Title, Mode=OneTime}">
                    <RadioButtons AutomationProperties.AutomationId="ReadComposePanePageReaderDarkModeMethodRadioButtons" SelectedIndex="{x:Bind ViewModel.SelectedReaderDarkModeMethodIndex, Mode=TwoWay}">
                        <RadioButton AutomationProperties.AutomationId="ReadComposePanePageReaderDarkModeAdaptiveRadio" Content="{x:Bind domain:Translator.SettingsReaderDarkModeMethod_Adaptive, Mode=OneTime}" />
                        <RadioButton AutomationProperties.AutomationId="ReadComposePanePageReaderDarkModeInvertedRadio" Content="{x:Bind domain:Translator.SettingsReaderDarkModeMethod_Inverted, Mode=OneTime}" />
                    </RadioButtons>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="ReadComposePanePageSettingsExpander2"
            Description="{x:Bind domain:Translator.SettingsComposerFontFamily_Description}"
            Header="{x:Bind domain:Translator.SettingsComposerFont_Title}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="TextFont" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard AutomationProperties.AutomationId="ReadComposePanePageSettingsCard4" Header="{x:Bind domain:Translator.SettingsFontFamily_Title}">
                    <ComboBox
                        AutomationProperties.AutomationId="ReadComposePanePageComboBox2"
                        ItemsSource="{x:Bind ViewModel.AvailableFonts}"
                        SelectedItem="{x:Bind ViewModel.CurrentComposerFont, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock FontFamily="{x:Bind}" Text="{x:Bind}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard AutomationProperties.AutomationId="ReadComposePanePageSettingsCard5" Header="{x:Bind domain:Translator.SettingsFontSize_Title}">
                    <NumberBox
                        AutomationProperties.AutomationId="ReadComposePanePageNumberBox2"
                        LargeChange="5"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.CurrentComposerFontSize, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard AutomationProperties.AutomationId="ReadComposePanePageSettingsCard6" Header="{x:Bind domain:Translator.SettingsFontPreview_Title}">
                    <TextBlock
                        FontFamily="{x:Bind ViewModel.CurrentComposerFont, Mode=OneWay}"
                        FontSize="{x:Bind ViewModel.CurrentComposerFontSize, Mode=OneWay}"
                        Text="The quick brown fox jumps over the lazy dog"
                        TextWrapping="WrapWholeWords" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="ComposerSpellCheckSettingsExpander"
            Description="{x:Bind domain:Translator.SettingsComposerSpellCheck_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsComposerSpellCheck_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="TextProofingTools" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard AutomationProperties.AutomationId="ComposerSpellCheckEnabledSettingsCard" Header="{x:Bind domain:Translator.SettingsComposerSpellCheckEnabled_Title, Mode=OneTime}">
                    <ToggleSwitch AutomationProperties.AutomationId="ComposerSpellCheckEnabledToggle" IsOn="{x:Bind ViewModel.PreferencesService.IsComposerSpellCheckEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="ComposerAutoCorrectSettingsCard"
                    Description="{x:Bind domain:Translator.SettingsComposerAutoCorrect_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsComposerAutoCorrect_Title, Mode=OneTime}">
                    <ToggleSwitch AutomationProperties.AutomationId="ComposerAutoCorrectToggle" IsOn="{x:Bind ViewModel.PreferencesService.IsComposerAutoCorrectEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard AutomationProperties.AutomationId="ComposerSpellCheckLanguageSettingsCard" Header="{x:Bind domain:Translator.SettingsComposerSpellCheckLanguage_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="ComposerSpellCheckLanguageComboBox"
                        ItemsSource="{x:Bind ViewModel.AvailableSpellCheckLanguages}"
                        SelectedItem="{x:Bind ViewModel.CurrentSpellCheckLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="translations:AppLanguageModel">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsCard
            AutomationProperties.AutomationId="ReadComposePanePageReaderActionsCard"
            Command="{x:Bind ViewModel.OpenReaderActionsCommand}"
            Description="{x:Bind domain:Translator.ReaderActions_EntryDescription, Mode=OneTime}"
            Header="{x:Bind domain:Translator.ReaderActions_Title, Mode=OneTime}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="ReOrderDotsVertical" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>

        <controls:SettingsCard AutomationProperties.AutomationId="ReadComposePanePageSettingsCard9" Header="{x:Bind domain:Translator.SettingsLoadStyles_Title}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Color" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch AutomationProperties.AutomationId="ReadComposePanePageToggleSwitch3" IsOn="{x:Bind ViewModel.PreferencesService.RenderStyles, Mode=TwoWay}" />
        </controls:SettingsCard>

        <controls:SettingsCard AutomationProperties.AutomationId="ReadComposePanePageSettingsCard10" Header="{x:Bind domain:Translator.SettingsLoadPlaintextLinks_Title}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Link" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch AutomationProperties.AutomationId="ReadComposePanePageToggleSwitch4" IsOn="{x:Bind ViewModel.PreferencesService.RenderPlaintextLinks, Mode=TwoWay}" />
        </controls:SettingsCard>
    </StackPanel>
</abstract:ReadComposePanePageAbstract>
